GOOGLE_API_KEY=your_key_here
VAULT_PATH=/app/notes
CHROMA_PATH=/app/chroma

# LLM provider: "gemini" (default) or "opencode"
# LLM_PROVIDER=opencode

# Opencode server URL (used when LLM_PROVIDER=opencode)
# OPENCODE_URL=http://opencode:4096

# Opencode provider (matches auth.json provider ID, e.g. opencode-go)
# OPENCODE_PROVIDER=opencode-go

# Opencode Go/Zen API key (used if auth.json isn't mounted)
# Set this when deploying to a remote server that doesn't have auth.json
# OPENCODE_GO_API_KEY=sk-...
